<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OrderedClicker.Mac.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="FontFamily" Value="PingFang SC, Helvetica Neue, sans-serif"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBrush}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.danger"><Setter Property="Background" Value="#B83E54"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="7"/><Setter Property="MinWidth" Value="112"/></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource CardBrush}"/></Style>
    <Style Selector="DataGrid"><Setter Property="RowHeight" Value="40"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  </Application.Styles>
</Application>
